// DCC Small Groups — Prisma schema
// Domain model: strict 3-by-3 organisational hierarchy
//   Region -> District -> Zone -> Area -> Section -> Cell

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisation hierarchy
// ---------------------------------------------------------------------------

enum OrgLevel {
  region
  district
  zone
  area
  section
  cell
}

// Level -> required parent level. Enforced by a trigger (see migration.sql)
// because Postgres has no native "parent must be exactly one level up" check.
model OrgUnit {
  id       String    @id @default(cuid())
  level    OrgLevel
  name     String
  code     String    @unique
  parentId String?
  parent   OrgUnit?  @relation("OrgUnitChildren", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitChildren")

  leaderId String?
  leader   User?   @relation("OrgUnitLeader", fields: [leaderId], references: [id])

  cell            Cell?
  roleAssignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([level])
}

// ---------------------------------------------------------------------------
// Users, invitations, sessions
// ---------------------------------------------------------------------------

enum UserStatus {
  invited
  active
  deactivated
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String?
  status       UserStatus @default(invited)

  invitationCode      String?   @unique
  invitationExpiresAt DateTime?

  // Super Admin TOTP secret; required 2nd factor on every sign-in for that role.
  totpSecret String?

  roleAssignments RoleAssignment[]
  ledUnits        OrgUnit[]        @relation("OrgUnitLeader")
  sessions        Session[]
  magicLinks      MagicLink[]

  submittedReports SundayReport[] @relation("ReportSubmittedBy")
  reviewedReports  SundayReport[] @relation("ReportReviewedBy")

  assignedFollowUps FollowUp[] @relation("FollowUpAssignedBy")

  auditLogEntries AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum CellRole {
  cell_leader
  section_leader
  area_coordinator
  zonal_coordinator
  district_coordinator
  regional_coordinator
  super_admin
}

// A user may hold more than one role assignment. Authorisation always derives
// from the subtree of `unitId`, never from the role name alone.
model RoleAssignment {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId String
  unit   OrgUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  role   CellRole

  createdAt DateTime @default(now())

  @@unique([userId, unitId, role])
  @@index([unitId])
  @@index([userId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  // Set once a session has satisfied its 2FA challenge (Super Admin only).
  mfaVerifiedAt DateTime?

  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cells
// ---------------------------------------------------------------------------

enum CellType {
  adult
  young_adult
  youth
  children
  mixed
}

model Cell {
  id        String   @id @default(cuid())
  unitId    String   @unique
  unit      OrgUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  cellType  CellType
  address   String
  latitude  Float
  longitude Float

  members       CellMember[]
  sundayReports SundayReport[]
  followUps     FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CellMemberRole {
  member
  assistant
  host
}

model CellMember {
  id         String         @id @default(cuid())
  cellId     String
  cell       Cell           @relation(fields: [cellId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  roleInCell CellMemberRole @default(member)
  joinedOn   DateTime
  active     Boolean        @default(true)

  attendance CellMemberAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cellId])
}

/**
 * Per-member, per-Sunday presence. One row per (member, report) once that
 * Sunday's figures are recorded — this is what the members register's
 * 8-Sunday presence strip and "missed 3+ weeks" rail are derived from; the
 * report's own `membersPresent` figure stays the sole source of truth for
 * the cell-wide attendance count.
 */
model CellMemberAttendance {
  id             String       @id @default(cuid())
  cellMemberId   String
  cellMember     CellMember   @relation(fields: [cellMemberId], references: [id], onDelete: Cascade)
  sundayReportId String
  sundayReport   SundayReport @relation(fields: [sundayReportId], references: [id], onDelete: Cascade)
  present        Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cellMemberId, sundayReportId])
  @@index([sundayReportId])
}

// ---------------------------------------------------------------------------
// Sunday reports
// ---------------------------------------------------------------------------

enum ReportChannel {
  web
  whatsapp
}

enum ReportStatus {
  draft
  pending
  approved
  sent_back
}

// The 24 integer figures, grouped into 5 categories. `null` = unanswered,
// `0` = an answered zero — never coalesce one into the other.
model SundayReport {
  id          String   @id @default(cuid())
  cellId      String
  cell        Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  serviceDate DateTime @db.Date

  submittedById String?
  submittedBy   User?         @relation("ReportSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  channel       ReportChannel @default(web)
  // True when a Section Leader files on behalf of a Cell Leader after the
  // reporting window closed (rule 1).
  filedByProxy  Boolean       @default(false)

  status       ReportStatus @default(draft)
  reviewedById String?
  reviewedBy   User?        @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // Membership (9)
  membersPresent           Int?
  guestCardsReceived       Int?
  decisionCardsReceived    Int?
  guestsTotalVisitation    Int?
  decisionsTotalVisitation Int?
  visitationPhysical       Int?
  visitationPhone          Int?
  visitationText           Int?
  visitationEmail          Int?

  // Maturity (4)
  membersPaidInFull        Int?
  baptismHolyGhost         Int?
  waterBaptism             Int?
  membershipClassGraduates Int?

  // Ministry (6)
  communionServiceHeld     Int?
  communityProjectsHeld    Int?
  lessPrivilegedVisitation Int?
  cellLeaderVisitation     Int?
  cellMemberVisitation     Int?
  prayerMeetingsHeld       Int?

  // Mission (4)
  newCellsBirthed    Int?
  converts           Int?
  guests             Int?
  outreachProgrammes Int?

  // Comments (1 numeric + free text)
  testimoniesShared Int?
  comments          String?

  memberAttendance CellMemberAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cellId, serviceDate])
  @@index([cellId, serviceDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Follow-ups
// ---------------------------------------------------------------------------

enum FollowUpType {
  new_guest
  new_convert
}

enum FollowUpStatus {
  not_contacted
  contacted
  joined_cell
  unable_to_reach
}

model FollowUp {
  id         String       @id @default(cuid())
  personName String
  phone      String
  type       FollowUpType
  address    String?
  latitude   Float?
  longitude  Float?

  assignedCellId String
  assignedCell   Cell   @relation(fields: [assignedCellId], references: [id])

  assignedById String
  assignedBy   User     @relation("FollowUpAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  status          FollowUpStatus @default(not_contacted)
  outcomeNote     String?
  outcomeLoggedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedCellId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// App settings (configurable thresholds — rule 5)
// ---------------------------------------------------------------------------

model AppSetting {
  key   String @id
  value String
}
